verifier/dist/aihash-verify*
python/.venv/
__pycache__/
*.pyc
.pytest_cache/
verifier/dist/verify.html
verifier/dist/aihash-verify.js
# Каталог собираемый, но ОБА его файла коммитятся — они нужны на чужой машине,
# а не только на нашей:
#   trust.json  — то, чему верит получатель; подмена корня обязана быть видна
#                 в обзоре кода и в истории;
#   verify.html — верификатор, который вкладывается в каждый пакет .seal. Без
#                 него колесо с PyPI собирает пакеты без проверялки, то есть
#                 тихо не выполняет главное обещание продукта.
# Игнор по каталогу трижды подряд глотал файл, нужный снаружи (assets, demo,
# снова assets). За содержимым колеса теперь следит test_package.py.
python/aihash/assets/*
!python/aihash/assets/trust.json
!python/aihash/assets/verify.html

# Мусор macOS. Раньше не попадал только из-за личного глобального игнора
# владельца — на чужой машине и в автосборке уехал бы в публикацию.
.DS_Store
*.egg-info/
typescript/dist/
typescript/node_modules/
# demo/ КОММИТИТСЯ ЦЕЛИКОМ. Это публичный пример: журнал с настоящим штампом,
# готовый пакет доказательства и верификатор одним файлом. Человек скачивает
# репозиторий, запускает проверку, правит один символ и видит отказ — без
# сборки и без единого вопроса нам. Пока эти строки были в игноре, README
# обещал то, чего в репозитории не было.
demo/selftest-*.html

# фикстуры коммитятся: без них проверка штампа
# третьей стороны в CI не работает
!spec/fixtures/**

# Служебный каталог setuptools. Попал в первый коммит и уехал в публикацию:
# `python -m build` создаёт его рядом с pyproject.toml, а правила на него не
# было. В пакеты на PyPI не просочился — их содержимое сторожит test_package.py.
python/build/
